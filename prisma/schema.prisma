}

model CommitteeMember {
  id                                String                  @id @default(cuid())
  committeeId                       String
  committee                         StandingCommittee       @relation(fields: [committeeId], references: [id])
  userId                            String?
  user                              User?                   @relation(fields: [userId], references: [id])
