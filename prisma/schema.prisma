  accessedById                      String
  accessedAt                        DateTime                @default(now())
  action                            String                  // VIEWED | CREATED | UPDATED | DOWNLOADED | SHARED
  resourceType                      String                  // ENCOUNTER | LAB_RESULT | MEDICATION | FULL_RECORD
