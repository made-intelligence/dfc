model PrescriptionItem {
  id                                String                  @id @default(cuid())
  prescriptionId                    String
  prescription                      Prescription            @relation(fields: [prescriptionId], references: [id])
  drugName                          String
  dose                              String
  form                              String?
  route                             String?
  frequency                         String
  duration                          String
  quantity                          String?
