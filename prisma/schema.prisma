  patientId                         String
  patient                           PatientProfile          @relation(fields: [patientId], references: [id])
  grantedToId                       String
  scope                             String                  @default("READ") // READ | FULL
  grantedAt                         DateTime                @default(now())
  expiresAt                         DateTime?
  revokedAt                         DateTime?
